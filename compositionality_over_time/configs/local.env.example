# Copy to local.env (ignored), edit the paths, and source only trusted settings.
# Pass its absolute path through COMPOUNDING_CONFIG when invoking a launcher.
export PYTHON_BIN=python3
export RSCRIPT_BIN=Rscript
export RATINGS_DIR=./data/ratings

# Keep OUTPUT_ROOT/CACHE_DIRECTORY/TEMP_DIRECTORY overrides stage-specific:
# extraction, feature generation and regressions write different datasets.
# All relative paths are resolved from the command's working directory.
